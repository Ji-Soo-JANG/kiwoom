KIWOOM_APP_KEY=replace-with-your-app-key
KIWOOM_SECRET_KEY=replace-with-your-secret-key
POSTGRES_PASSWORD=change-this-password
APP_USERNAME=admin
APP_PASSWORD=change-this-login-password
KIWOOM_DAILY_PRICE_CACHE_TTL=10m
DATABASE_USERNAME=kiwoom
DATABASE_R2DBC_URL=r2dbc:postgresql://localhost:5432/kiwoom
DATABASE_JDBC_URL=jdbc:postgresql://localhost:5432/kiwoom
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8080
TRADING_MODE=PAPER
TRADING_SCHEDULER_ENABLED=true
TRADING_SCHEDULER_CRON=0 5 9 * * MON-FRI
SWING_MONITOR_ENABLED=true
SWING_MONITOR_CRON=0 */1 9-15 * * MON-FRI
SWING_CLOSE_CRON=0 35 15 * * MON-FRI

# 실제 키움 API 통합 테스트 전용 설정. 애플리케이션 실행 키와 분리해서 관리합니다.
KIWOOM_LIVE_ENV=PAPER
KIWOOM_LIVE_STOCK_CODE=005930
KIWOOM_PAPER_BASE_URL=replace-with-paper-api-url
KIWOOM_PAPER_APP_KEY=replace-with-paper-app-key
KIWOOM_PAPER_SECRET_KEY=replace-with-paper-secret-key
KIWOOM_PROD_BASE_URL=replace-with-production-api-url
KIWOOM_PROD_APP_KEY=replace-with-production-app-key
KIWOOM_PROD_SECRET_KEY=replace-with-production-secret-key
